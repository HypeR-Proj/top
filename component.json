{
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "version": 1,
  "name": "top",
  "kind": "application",
  "tests": [
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-top"
    ]
  ],
  "cargo": [
    {
      "manifest": "Cargo.toml",
      "domain": "system"
    }
  ],
  "artifacts": [
    {
      "binary": "hyper-top",
      "staged": "top",
      "destination": "bin/top",
      "mode": "0755",
      "profiles": [
        "development"
      ],
      "rust_runtime": "std",
      "environment": "system",
      "manifest": "Cargo.toml",
      "enabled": true
    }
  ],
  "build": {
    "type": "native-rust",
    "requires": [
      "toolchain"
    ]
  }
}
